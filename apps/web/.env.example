# Public FastAPI base URL, without /api/v1 or credentials.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Hosted Supabase browser configuration. Use your own project publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical HTTPS origin for production auth callbacks and recovery.
AUTH_APP_ORIGIN=

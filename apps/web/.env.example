# Public FastAPI base URL, without /api/v1 or credentials.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Server-only override for authenticated server calls and the workspace proxy.
API_BASE_URL=http://localhost:8000

# Hosted Supabase browser configuration. Use your own project publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Frontend origin including local port; use the canonical HTTPS domain in production.
AUTH_APP_ORIGIN=http://localhost:3000
